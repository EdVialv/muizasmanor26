# Public application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Day 7 — see docs/SUPABASE_SETUP.md)
# Safe to expose to browser code; Row Level Security protects data, not key secrecy.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Bypasses Row Level Security. Never prefix with NEXT_PUBLIC_ or
# let this reach browser-bundled code. Do not use the legacy service_role key.
SUPABASE_SECRET_KEY=
# Direct Postgres connection string, for migrations and server-side scripts.
# Day 8 may add a second pooled-connection variable alongside this one.
SUPABASE_DB_URL=

# Base-map tiles for /map (Day 19 — see docs/DAY19_MAP_NOTES.md, "Tiles").
# Read on the server and sent to the browser, so any key in the URL is
# public: use a key or account restricted to the site's domain. Leave
# MAP_TILE_URL empty to use the OpenStreetMap Foundation's standard tiles in
# development only; production then shows objects without a base map until
# a provider is chosen. Do not enable a paid plan without authorisation.
# Example (Stadia Maps, domain authentication, no key):
#   MAP_TILE_URL=https://tiles.stadiamaps.com/tiles/alidade_smooth/{z}/{x}/{y}{r}.png
#   MAP_TILE_ATTRIBUTION=© Stadia Maps © OpenMapTiles © OpenStreetMap contributors
MAP_TILE_URL=
MAP_TILE_ATTRIBUTION=
MAP_TILE_MAX_ZOOM=

# Add further service-specific placeholders only when each integration is implemented.
# Never place real credentials in this file.
