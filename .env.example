# Public application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Day 7 — see docs/SUPABASE_SETUP.md)
# Safe to expose to browser code; Row Level Security protects data, not key secrecy.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Bypasses Row Level Security. Never prefix with NEXT_PUBLIC_ or
# let this reach browser-bundled code. Do not use the legacy service_role key.
SUPABASE_SECRET_KEY=
# Direct Postgres connection string, for migrations and server-side scripts.
# Day 8 may add a second pooled-connection variable alongside this one.
SUPABASE_DB_URL=

# Add further service-specific placeholders only when each integration is implemented.
# Never place real credentials in this file.
